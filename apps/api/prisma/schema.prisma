generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LocationStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
  MAINTENANCE

  @@map("location_status")
}

enum MovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT

  @@map("movement_type")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  OPERATOR
  VIEWER

  @@map("user_role")
}

model Warehouse {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  description String?
  active Boolean @default(true)
  zones Zone[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("warehouses")
}

model Zone {
  id String @id @default(uuid()) @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  code String
  name String
  type String?
  temperature String?
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  aisles Aisle[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("zones")
}

model Aisle {
  id String @id @default(uuid()) @db.Uuid
  zoneId String @map("zone_id") @db.Uuid
  code String
  name String
  zone Zone @relation(fields: [zoneId], references: [id])
  racks Rack[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([zoneId, code])
  @@index([zoneId])
  @@map("aisles")
}

model Rack {
  id String @id @default(uuid()) @db.Uuid
  aisleId String @map("aisle_id") @db.Uuid
  code String
  name String
  rackType String @map("rack_type")
  levels Int
  positions Int
  aisle Aisle @relation(fields: [aisleId], references: [id])
  locations Location[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([aisleId, code])
  @@index([aisleId])
  @@map("racks")
}

model Location {
  id String @id @default(uuid()) @db.Uuid
  rackId String @map("rack_id") @db.Uuid
  code String @unique
  level Int
  position Int
  status LocationStatus @default(AVAILABLE)
  width Decimal? @db.Decimal(10, 2)
  depth Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)
  maxWeight Decimal? @map("max_weight") @db.Decimal(10, 2)
  rack Rack @relation(fields: [rackId], references: [id])
  inventory Inventory[]
  sourceMovements Movement[] @relation("sourceLocation")
  destinationMovements Movement[] @relation("destinationLocation")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([rackId, level, position])
  @@index([status])
  @@map("locations")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  sku String @unique
  name String
  description String?
  barcode String? @unique
  unit String
  category String?
  brand String?
  active Boolean @default(true)
  inventory Inventory[]
  movements Movement[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([name])
  @@map("products")
}

model Inventory {
  id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  quantity Int @default(0)
  reservedQuantity Int @default(0) @map("reserved_quantity")
  product Product @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("inventory")
}

model Movement {
  id String @id @default(uuid()) @db.Uuid
  type MovementType
  productId String @map("product_id") @db.Uuid
  quantity Int
  sourceLocationId String? @map("source_location_id") @db.Uuid
  destinationLocationId String? @map("destination_location_id") @db.Uuid
  reference String?
  reason String?
  userId String? @map("user_id") @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  sourceLocation Location? @relation("sourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation Location? @relation("destinationLocation", fields: [destinationLocationId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  @@index([productId])
  @@index([createdAt])
  @@index([type])
  @@map("movements")
}

model User {
  id String @id @db.Uuid
  name String
  role UserRole @default(OPERATOR)
  active Boolean @default(true)
  movements Movement[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("user_profiles")
}
