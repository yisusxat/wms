{
  "name": "wms",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "dependencies": {
    "next": "15.5.25"
  },
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "start:api": "node apps/api/dist/main.js",
    "build": "npm run build:api",
    "start": "npm run start:api",
    "build:api": "npm --workspace apps/api run build",
    "build:apiyarn": "npm run build:api",
    "build:web": "npm --workspace apps/web run build",
    "start:web": "npm --workspace apps/web run start",
    "db:generate": "npm --workspace apps/api run prisma:generate",
    "db:seed": "npm --workspace apps/api run prisma:seed",
    "test:api": "npm --workspace apps/api run test",
    "test:e2e": "npm run build:web && playwright test",
    "test:integration": "npm --workspace apps/api run test -- --runInBand --runTestsByPath test/integration.database.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
